{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "devai-ui",
  "version": "0.1.0",
  "identifier": "app.devai.ui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "devai-ui",
        "width": 1280,
        "height": 860,
        "minWidth": 940,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        { "scheme": ["devai"], "host": "pair", "path": [] }
      ],
      "desktop": {
        "schemes": []
      }
    }
  }
}
