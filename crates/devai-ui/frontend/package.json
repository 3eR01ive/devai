{
  "name": "devai-ui-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:codes": "node scripts/gen-home-codes.mjs && node scripts/gen-pair-vocabulary.mjs",
    "build": "npm run gen:codes && vite build",
    "typecheck": "npm run gen:codes && vue-tsc --noEmit",
    "preview": "vite preview",
    "test": "node scripts/gen-pair-vocabulary.mjs --check && vitest run && node --import ./tests/support/register-ts.mjs --test tests/*.test.ts",
    "check": "node scripts/gen-home-codes.mjs && node scripts/gen-pair-vocabulary.mjs --check && vue-tsc --noEmit && node --import ./tests/support/register-ts.mjs --test tests/*.test.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@types/prismjs": "^1.26.6",
    "prismjs": "^1.30.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
